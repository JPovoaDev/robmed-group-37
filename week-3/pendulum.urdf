<?xml version="1.0"?>
<!--
  Motorised pendulum for the control lab.

  Conventions:
    * the post is vertical, along +z;
    * motor_joint (the shoulder) is at (0, -0.25, 1.3): above the post and 0.25 m to its side,
      so the arm swings in the plane y = -0.25, beside the post and never through it;
    * the joint frame is rotated 90 degrees about y (rpy="0 1.5707963 0"), so at q = 0 the arm
      points straight DOWN (-z). This is the convention of the lecture: q = 0 is the stable
      equilibrium, q = pi/2 is horizontal (maximum gravity load), q = pi is upright;
    * positive q swings the arm towards +x;
    * the joint has viscous damping (0.5 N m s/rad) and friction (0.2 N m), like a real motor
      and gearbox. They are not part of the rigid-body model.

  Mass properties you need for the hand calculations (all in the arm plane, about the joint axis):
    motor_link : 1.0 kg on the joint axis, inertia about the axis 0.0018 kg m^2
    arm_link   : 0.005 kg uniform rod, 0.8 m long, centre of mass at 0.4 m (light: negligible)
    ball_link  : 1.0 kg  at 0.8 m,              
-->
<robot name="pendulum">

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder radius="0.25" length="0.1"/></geometry>
      <material name="cyan"><color rgba="0 0.9 0.9 1.0"/></material>
    </visual>
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="100"/>
      <inertia ixx="10" ixy="0" ixz="0" iyy="10" iyz="0" izz="10"/>
    </inertial>
  </link>

  <link name="body_link">
    <visual>
      <origin xyz="0 0 0.6" rpy="0 0 0"/>
      <geometry><cylinder radius="0.08" length="1.2"/></geometry>
      <material name="blue"><color rgba="0 0 0.9 1.0"/></material>
    </visual>
    <inertial>
      <origin xyz="0 0 0.6" rpy="0 0 0"/>
      <mass value="5"/>
      <inertia ixx="0.6" ixy="0" ixz="0" iyy="0.6" iyz="0" izz="0.05"/>
    </inertial>
  </link>

  <!-- Motor housing: a cylinder along the joint axis (y), from the post to the arm. -->
  <link name="motor_link">
    <visual>
      <origin xyz="0 0.1 0" rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.06" length="0.3"/></geometry>
      <material name="cyan"><color rgba="0 0.9 0.9 1.0"/></material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0084" ixy="0" ixz="0" iyy="0.0018" iyz="0" izz="0.0084"/>
    </inertial>
  </link>

  <!-- Arm: 0.8 m long, along +x of its own frame. -->
  <link name="arm_link">
    <visual>
      <origin xyz="0.4 0 0" rpy="0 1.5707963 0"/>
      <geometry><cylinder radius="0.025" length="0.8"/></geometry>
      <material name="red"><color rgba="0.6 0 0 1.0"/></material>
    </visual>
    <inertial>
      <origin xyz="0.4 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="0.0000016" ixy="0" ixz="0" iyy="0.000267" iyz="0" izz="0.000267"/>
    </inertial>
  </link>

  <!-- Ball (payload) at the end of the arm. Its frame origin is exactly the arm tip. -->
  <link name="ball_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.08"/></geometry>
      <material name="green"><color rgba="0 1 0 1"/></material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.00512" ixy="0" ixz="0" iyy="0.00512" iyz="0" izz="0.00512"/>
    </inertial>
  </link>

  <joint name="post_fixed" type="fixed">
    <parent link="base_link"/>
    <child link="body_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- The only moving joint: the shoulder. -->
  <joint name="motor_joint" type="continuous">
    <parent link="body_link"/>
    <child link="motor_link"/>
    <origin xyz="0 -0.25 1.3" rpy="0 1.5707963 0"/>
    <axis xyz="0 -1 0"/>
    <dynamics damping="0.5" friction="0.2"/>
  </joint>

  <joint name="arm_fixed" type="fixed">
    <parent link="motor_link"/>
    <child link="arm_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="ball_fixed" type="fixed">
    <parent link="arm_link"/>
    <child link="ball_link"/>
    <origin xyz="0.8 0 0" rpy="0 0 0"/>
  </joint>

</robot>
