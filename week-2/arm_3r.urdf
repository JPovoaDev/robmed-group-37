<?xml version="1.0"?>
<!--
  Motorised pendulum, tidied version.

  Frame conventions (all link frames are aligned with the world frame when q = 0):
    * the post is vertical, along +z;
    * the motor_joint (shoulder) is at (0, -0.25, 1.3): above the post and 0.25 m to its side,
      so the arm swings in the plane y = -0.25, beside the post and never through it;
    * the joint axis is -y, so a positive angle lifts the arm UP in the x-z plane;
    * at q = 0 the arm points along +x (horizontal).
  The only rpy values in this file are inside <visual>/<inertial> tags. They rotate the
  cylinder shapes (which PyBullet builds along z) so that they lie along x or y.
  They do not change any frame.
-->
<robot name="pend_robot">

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder radius="0.25" length="0.1"/></geometry>
      <material name="cyan"><color rgba="0 0.9 0.9 1.0"/></material>
    </visual>
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="100"/>
      <inertia ixx="10" ixy="0" ixz="0" iyy="10" iyz="0" izz="10"/>
    </inertial>
  </link>

  <link name="body_link">
    <visual>
      <origin xyz="0 0 0.6" rpy="0 0 0"/>
      <geometry><cylinder radius="0.08" length="1.2"/></geometry>
      <material name="blue"><color rgba="0 0 0.9 1.0"/></material>
    </visual>
    <inertial>
      <origin xyz="0 0 0.6" rpy="0 0 0"/>
      <mass value="5"/>
      <inertia ixx="0.6" ixy="0" ixz="0" iyy="0.6" iyz="0" izz="0.05"/>
    </inertial>
  </link>

  <!-- Motor housing: a cylinder along the joint axis (y), from the post to the arm. -->
  <link name="motor_link">
    <visual>
      <origin xyz="0 0.1 0" rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.06" length="0.3"/></geometry>
      <material name="cyan"><color rgba="0 0.9 0.9 1.0"/></material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <!-- Arm: 0.8 m long, along +x of its own frame. -->
  <link name="arm_link">
    <visual>
      <origin xyz="0.4 0 0" rpy="0 1.5707963 0"/>
      <geometry><cylinder radius="0.025" length="0.8"/></geometry>
      <material name="red"><color rgba="0.6 0 0 1.0"/></material>
    </visual>
    <inertial>
      <origin xyz="0.4 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.03"/>
    </inertial>
  </link>

  <!-- Ball at the end of the arm. Its frame origin is exactly the arm tip. -->
  <link name="ball_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.08"/></geometry>
      <material name="green"><color rgba="0 1 0 1"/></material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
  </link>

  <link name="arm2_link">
    <visual>
      <origin xyz="0.3 0 0" rpy="0 1.5707963 0"/>
      <geometry><cylinder radius="0.025" length="0.6"/></geometry>
      <material name="blue"><color rgba="0.6 0 0 1.0"/></material>
    </visual>
    <inertial>
      <origin xyz="0.3 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.03"/>
    </inertial>
  </link>

  <link name="tip_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.04"/></geometry>
      <material name="yellow"><color rgba="1 1 0 1"/></material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="base_joint" type="continuous">
    <parent link="base_link"/>
    <child link="body_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <!-- The only moving joint: the shoulder. -->
  <joint name="motor_joint" type="continuous">
    <parent link="body_link"/>
    <child link="motor_link"/>
    <origin xyz="0 -0.25 1.3" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <joint name="arm_fixed" type="fixed">
    <parent link="motor_link"/>
    <child link="arm_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="ball_fixed" type="fixed">
    <parent link="arm_link"/>
    <child link="ball_link"/>
    <origin xyz="0.8 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="elbow_joint" type="continuous">
    <parent link="ball_link"/>
    <child link="arm2_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <joint name="tip_fixed" type="fixed">
    <parent link="arm2_link"/>
    <child link="tip_link"/>
    <origin xyz="0.6 0 0" rpy="0 0 0"/>
  </joint>

</robot>
